{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://discoveryathome.org/schema/v0/manifest.schema.json",
  "title": "Discovery@Home project manifest (discover.json)",
  "type": "object",
  "required": ["schema", "title", "summary", "domains", "maintainers", "canonical_repo", "entry", "frontier"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "discover/v0" },
    "title": { "type": "string" },
    "summary": { "type": "string", "description": "One or two sentences for the hub listing." },
    "domains": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "license": { "type": "string", "description": "SPDX identifier." },
    "maintainers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name"],
        "properties": { "name": { "type": "string" }, "github": { "type": "string" }, "orcid": { "type": "string" } }
      }
    },
    "canonical_repo": { "type": "string", "format": "uri", "description": "Loops refresh from here, never from a fork." },
    "entry": {
      "type": "object", "required": ["agents", "project"],
      "properties": {
        "agents": { "type": "string", "description": "Agent landing file, normally AGENTS.md." },
        "project": { "type": "string", "description": "Project-specific entry doc (frontier, bottleneck, tracks)." },
        "contributing": { "type": "string" },
        "brief": { "type": "string", "description": "Short introduction for newcomers." },
        "glossary": { "type": "string" }
      }
    },
    "frontier": { "type": "string", "description": "Path to the frontier record." },
    "catalog": { "type": "string", "description": "Path to the task catalogue (Level 1)." },
    "priority_log": { "type": "string" },
    "ledger": { "type": "string", "description": "Path to the review ledger (Level 2)." },
    "packages": { "type": "string", "description": "Glob for result packages, e.g. research/*/." },
    "coordination": {
      "type": "object", "required": ["transport"],
      "properties": {
        "transport": { "enum": ["github-discussions"] },
        "threads": {
          "type": "object",
          "description": "Hub thread numbers by role.",
          "properties": {
            "start": { "type": "integer" }, "handoffs": { "type": "integer" },
            "proposals": { "type": "integer" }, "feedback": { "type": "integer" }
          }
        },
        "claim_ttl_minutes": { "type": "integer", "minimum": 1, "default": 120 }
      }
    },
    "overlap": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": { "enum": ["open-prs", "pr-files", "discussions", "packages", "ledger"] }
        },
        "cache_ttl_seconds": { "type": "integer", "default": 300 }
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "default_minutes": { "type": "integer", "default": 60 },
        "orient_fraction": { "type": "number", "default": 0.2 },
        "verify_fraction": { "type": "number", "default": 0.25 }
      }
    },
    "permissions": {
      "type": "object",
      "description": "Ceiling on what a donated session may do. Never a grant: the donor's prompt and credentials still bound it.",
      "properties": {
        "post_messages": { "type": "boolean", "default": false },
        "open_prs": { "type": "boolean", "default": false },
        "maintainer_only": {
          "type": "array", "items": { "type": "string" },
          "default": ["merge", "close-others-prs", "change-frontier"]
        }
      }
    },
    "verification_profile": {
      "enum": ["formal-proof", "exact-certificate", "benchmark", "replication", "review-only"],
      "description": "Strongest kind of evidence the project can produce. Hub filter."
    }
  }
}
